[Unit]
Description=Cloudflare Tunnel for SilverBullet (token-managed)
Wants=network-online.target
After=network-online.target
Requires=silverbullet.service
After=silverbullet.service

[Container]
ContainerName=silverbullet-cloudflared
Image=docker.io/cloudflare/cloudflared:latest
Network=silverbullet.network
Exec=tunnel --no-autoupdate run
# TUNNEL_TOKEN lives in this env file (never on the command line).
EnvironmentFile=%h/silverbullet/cloudflared.env
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
