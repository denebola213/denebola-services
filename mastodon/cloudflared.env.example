# Cloudflare Tunnel token for Mastodon.
# Copy to ~/mastodon/cloudflared.env and chmod 600. Never commit the real file.
#
# This is the EXISTING tunnel from the old rock5b stack — NOT a new tunnel.
# At migration time it is copied verbatim from rock5b's tunnel.env
# (TUNNEL_TOKEN=...). The tunnel is token-managed: the public hostname
# mstdn.nostalgia-tns.net and its service URL http://proxy:4430 live in the
# Cloudflare dashboard and need NO change, because mastodon-proxy keeps the
# "proxy" network alias (see mastodon-proxy.container).

TUNNEL_TOKEN=change-me
