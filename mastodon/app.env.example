# Mastodon application environment — shared by web / sidekiq / streaming.
# Copy to ~/mastodon/app.env and chmod 600. Never commit the real file.
#
# At migration time this file is copied VERBATIM from rock5b's web.env
# (DB_HOST=db and REDIS_HOST=redis still resolve via network aliases, so no
# value needs editing).

# Federation — identifies the server. Cannot be changed safely later.
LOCAL_DOMAIN=mstdn.nostalgia-tns.net
# LOCAL_HTTPS=true
# ALTERNATE_DOMAINS=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# PostgreSQL
DB_HOST=db
DB_USER=mastodon
DB_NAME=mastodon_production
DB_PASS=change-me
DB_PORT=5432

# Elasticsearch (optional, not migrated)
ES_ENABLED=false
# ES_HOST=
# ES_PORT=
# ES_USER=
# ES_PASS=

# Secrets (generate with `rake secret`)
SECRET_KEY_BASE=change-me
OTP_SECRET=change-me

# Web Push (generate with `rake mastodon:webpush:generate_vapid_key`)
VAPID_PRIVATE_KEY=change-me
VAPID_PUBLIC_KEY=change-me

# Sending mail
SMTP_SERVER=
SMTP_PORT=587
# SMTP_LOGIN=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=

# File storage (optional)
S3_ENABLED=false
# S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ALIAS_HOST=

# IP and session retention
IP_RETENTION_PERIOD=31556952
SESSION_RETENTION_PERIOD=31556952

# Active Record encryption (ver. 4.3+)
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=change-me
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=change-me
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=change-me
