# Mastodon PostgreSQL environment.
# Copy to ~/mastodon/postgres.env and chmod 600. Never commit the real file.
#
# DB_PASS in app.env must carry the SAME value as POSTGRES_PASSWORD here:
# the database directory's password is baked in at initdb time, and the app
# connects with DB_PASS. Changing one without the other locks the app out.
# At migration time both files are copied verbatim from rock5b (db.env).

POSTGRES_USER=mastodon
POSTGRES_DB=mastodon_production
POSTGRES_PASSWORD=change-me
PGDATA=/var/lib/postgresql/data/
TZ=Asia/Tokyo
