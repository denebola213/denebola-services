# Hermes backup env — used only by hermes-backup.service
#
# 配置先: ~/hermes/backup.env
#   cp backup.env.example ~/hermes/backup.env
#   chmod 600 ~/hermes/backup.env
#
# OMV 側で SSH を有効化し、専用ユーザへ FCOS の公開鍵を登録しておくこと
# （詳細は README 第 8 章）。

# 接続先 (OMV)
BACKUP_SFTP_HOST=omv.local
BACKUP_SFTP_PORT=22
BACKUP_SFTP_USER=backup
# 退避先ディレクトリ (OMV のデータディスク上の絶対パス)
BACKUP_SFTP_PATH=/srv/dev-disk-by-uuid-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX/backup/hermes

# SSH 秘密鍵。%h はホームディレクトリに展開される。
BACKUP_SSH_KEY=%h/.ssh/id_ed25519

# 保持日数
BACKUP_KEEP_DAYS=14
