# cloudflared env — used only by cloudflared.container
#
# 配置先: ~/hermes/cloudflared.env
#   cp cloudflared.env.example ~/hermes/cloudflared.env
#   chmod 600 ~/hermes/cloudflared.env
#
# Zero Trust ダッシュボード > Networks > Tunnels でトンネルを作成し、
# 「Install connector」で表示されるトークンを貼り付ける。

TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token
