[Unit]
Description=Hermes Agent (gateway)
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=hermes-agent
Image=docker.io/nousresearch/hermes-agent:latest
Exec=gateway run
Network=hermes.network
Volume=hermes-home.volume:/home/hermes/.hermes
Volume=hermes-agent-src.volume:/opt/hermes
EnvironmentFile=%h/hermes/hermes.env
Environment=HERMES_HOME=/home/hermes/.hermes
Environment=API_SERVER_ENABLED=true
Environment=API_SERVER_HOST=0.0.0.0
# Built-in management dashboard, supervised by s6 next to the gateway.
# Non-loopback bind engages the auth gate; an auth provider (self-hosted
# OIDC via HERMES_DASHBOARD_OIDC_*, see hermes.env.example) is required
# or the dashboard fails closed.
Environment=HERMES_DASHBOARD=1
Environment=HERMES_DASHBOARD_HOST=0.0.0.0
Environment=HERMES_DASHBOARD_PORT=9119
# rootless: map the HOST uid/gid onto the image's hermes uid/gid (10000).
# Plain "keep-id" injects the host user at uid 1000, which collides with the
# image's usermod -u HERMES_UID (uid already exists) and aborts stage2, leaving
# hermes at 10000 so it cannot write the shared volume. Mapping to 10000 keeps
# host-owned files while avoiding the collision. Set HERMES_UID/HERMES_GID=10000
# in hermes.env (see hermes.env.example).
UserNS=keep-id:uid=10000,gid=10000
# Loopback only. The WebUI reaches the gateway over hermes.network.
PublishPort=127.0.0.1:8642:8642
# Loopback only. cloudflared reaches the dashboard over hermes.network.
PublishPort=127.0.0.1:9119:9119
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
