[Unit]
Description=Build derived hermes-webui image with sudo (localhost/hermes-webui:apt)

[Build]
# コンテキストはこの Containerfile の親ディレクトリ（hermes/）
File=Containerfile.apt
SetWorkingDirectory=file
ImageTag=localhost/hermes-webui:apt
# 上流 :latest の更新を取り込む。ダイジェストが変わらなければ pull しない
Pull=newer
# .build は --build-arg を直接書けないため PodmanArgs で渡す
PodmanArgs=--build-arg BASE=ghcr.io/nesquena/hermes-webui:latest
