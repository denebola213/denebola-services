# Hermes env — shared by hermes-agent.container and hermes-webui.container
#
# 配置先: ~/hermes/hermes.env   ( quadlet からは %h/hermes/hermes.env で参照 )
#   cp hermes.env.example ~/hermes/hermes.env
#   chmod 600 ~/hermes/hermes.env
#
# UID/GID マッピング (rootless + keep-id 運用)
#
# 2 つのコンテナで意味が異なる:
#   hermes-agent : UserNS=keep-id:uid=10000,gid=10000 で起動し、ホスト UID を
#                  イメージ内 hermes ユーザーの UID/GID 10000 にマップする。
#                  よって HERMES_UID / HERMES_GID は 10000 固定 (変更しない)。
#   hermes-webui : ホスト UID/GID をそのまま使う (WANTED_UID / WANTED_GID)。
#
# 自分のホスト UID/GID を確認して WANTED_UID / WANTED_GID に入れる:
#   id -u   # => WANTED_UID
#   id -g   # => WANTED_GID
HERMES_UID=10000
HERMES_GID=10000
WANTED_UID=1000
WANTED_GID=1000

# Gateway API キー (16 文字以上)。未設定だと WebUI の System 表示が
# "Gateway endpoint not reachable" になり、スケジュール実行が動かない。
# 下の HERMES_WEBUI_GATEWAY_API_KEY と必ず同じ値にする。
API_SERVER_KEY=change-me-to-a-long-random-string
HERMES_WEBUI_GATEWAY_API_KEY=change-me-to-a-long-random-string

# WebUI のログインパスワード。トンネルで外部公開する場合は必須。
HERMES_WEBUI_PASSWORD=change-me-to-something-strong

# Cloudflare Tunnel で公開するホスト名。WebUI の Origin 検証に必要。
# 例: https://hermes.example.com
HERMES_WEBUI_ALLOWED_ORIGINS=https://hermes.example.com

# 逆プロキシ (cloudflared) 配下で動かすための設定。
HERMES_WEBUI_SECURE=1
HERMES_WEBUI_TRUST_FORWARDED_HOST=1
HERMES_WEBUI_TRUST_FORWARDED_FOR=1
HERMES_WEBUI_TRUST_FORWARDED_PROTO=1
