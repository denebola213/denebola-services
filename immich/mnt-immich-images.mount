[Unit]
Description=Immich originals (OMV btrfs over NFS)
# Installed to /etc/systemd/system/ because mounting NFS needs root; the
# containers themselves run rootless and only bind-mount the result.
After=network-online.target
Wants=network-online.target

[Mount]
What=192.168.20.103:/immich-images
Where=/mnt/immich-images
Type=nfs4
# context= is the only way to give an NFS path a container-usable SELinux label:
# :z/:Z cannot relabel NFS, and without it rootless podman gets "Permission denied".
Options=vers=4,soft,timeo=180,context="system_u:object_r:container_file_t:s0"

[Install]
WantedBy=multi-user.target
