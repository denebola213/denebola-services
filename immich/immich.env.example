# Immich — env for the rootless Quadlet stack.
# Copy to ~/immich/immich.env and chmod 600. Never commit the real file.
#
# The database directory must be a *fresh* directory: rootless podman can only
# chown a directory the invoking user owns (`:U`), so the DB is created by
# initdb and filled from a logical dump — see the migration section in README.md.

TZ=Asia/Tokyo

# Database (also consumed by immich-postgres at initdb time)
DB_USERNAME=postgres
DB_DATABASE_NAME=postgres
DB_PASSWORD=change-me
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=change-me

# Service discovery: the container names are fixed by the units.
DB_HOSTNAME=immich-postgres
DB_PORT=5432
REDIS_HOSTNAME=immich-valkey
IMMICH_MACHINE_LEARNING_URL=http://immich-ml:3003
