# Cloudflare Tunnel token for Immich.
# Copy to ~/immich/cloudflared.env and chmod 600. Never commit the real file.
#
# The tunnel is token-managed: public hostnames and the origin service URL live
# in the Cloudflare dashboard, not in this repository. The origin must be
# http://immich_server:2283 — the server unit publishes that alias on the
# immich network, which is why the container name stays immich-server while the
# alias keeps the old underscore spelling.

TUNNEL_TOKEN=change-me
