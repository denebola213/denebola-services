[Unit]
Description=Immich machine learning (CPU inference, model cache on NVMe)
Wants=immich.network
After=immich.network

[Container]
ContainerName=immich-ml
# Keep this tag in lockstep with immich-server.
Image=ghcr.io/immich-app/immich-machine-learning:v3.4.1
Network=immich.network
NetworkAlias=immich-machine-learning
Volume=%h/immich/data/ml-cache:/cache:Z
EnvironmentFile=%h/immich/immich.env

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
