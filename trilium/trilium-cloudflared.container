[Unit]
Description=Cloudflare Tunnel for Trilium (token-managed)
Wants=network-online.target
After=network-online.target
Requires=trilium.service
After=trilium.service

[Container]
ContainerName=trilium-cloudflared
Image=docker.io/cloudflare/cloudflared:latest
Network=trilium.network
Exec=tunnel --no-autoupdate run
# TUNNEL_TOKEN lives in this env file (never on the command line).
EnvironmentFile=%h/trilium/cloudflared.env
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
